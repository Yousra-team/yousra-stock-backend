# Copy this file to `.env` and replace the placeholders. This project runs secrets
# through Doppler (`doppler run -- <command>`) rather than a committed `.env` — this
# file is documentation of what's expected, not the real values.

# Connection string for PostgreSQL. Requires PostgreSQL >= 15.
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Signing secret for auth JWTs — any long random string, kept out of version control.
JWT_SECRET="replace-with-a-long-random-string"

# HTTP port the API listens on. Optional — defaults to 8000.
PORT=8000
