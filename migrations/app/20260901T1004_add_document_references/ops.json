        "params": [
          "\"public\".\"documentCounter\""
        ]
      }
    ],
    "execute": [
      {
        "description": "create table \"documentCounter\"",
        "sql": "CREATE TABLE \"public\".\"documentCounter\" (\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"day\" text NOT NULL,\n  \"scope\" text NOT NULL,\n  \"updatedAt\" timestamptz NOT NULL,\n  \"value\" int4 NOT NULL,\n  PRIMARY KEY (\"scope\", \"day\")\n)",
        "params": []
      }
    ],
    "postcheck": [
      {
        "description": "verify table \"documentCounter\" exists",
        "sql": "SELECT (to_regclass($1)) IS NOT NULL AS \"result\"",
        "params": [
          "\"public\".\"documentCounter\""
        ]
      }
    ]
  },
