    "id": "table.documentCounter",
    "label": "Create table \"documentCounter\"",
    "summary": "Creates table \"documentCounter\"",
    "operationClass": "additive",
    "target": {
      "id": "postgres",
      "details": {
        "schema": "public",
        "objectType": "table",
        "name": "documentCounter"
      }
    },
    "precheck": [
      {
        "description": "ensure table \"documentCounter\" does not exist",
